# Sarvam model APIs (dashboard.sarvam.ai) - Sarvam-105B for search extraction + simulator
SARVAM_API_KEY=your-sarvam-model-api-key
# Tavily web search (app.tavily.com)
TAVILY_API_KEY=your-tavily-key
# Sarvam Voice Agents platform (indus.sarvam.ai/samvaad -> Settings -> API Key) - voice calls from the page
SARVAM_VOICE_KEY=your-voice-agents-key
# Your own Voice Agents workspace + agents (only needed if you run your own agents)
# SARVAM_ORG_ID=
# SARVAM_WORKSPACE_ID=
# SEEKER_APP_ID=
# LANDLORD_APP_ID=
